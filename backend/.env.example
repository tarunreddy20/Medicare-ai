# Groq LLM Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# CORS — set to your Vercel frontend URL for production
# Example: https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://YOUR-APP.vercel.app

# ChromaDB path (Render disk mount)
CHROMA_DB_PATH=/opt/render/project/data/chroma_db

# ===== LOGIN EMAIL NOTIFICATIONS =====
# Admin email that receives login alerts
ADMIN_EMAIL=your-email@gmail.com

# SMTP credentials (use Gmail App Password)
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
