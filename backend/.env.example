AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# CORS — set to your Vercel frontend URL for production
# Example: https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://YOUR-APP.vercel.app

# ChromaDB path (Render disk mount)
CHROMA_DB_PATH=/opt/render/project/data/chroma_db
